{
  "id": "launch-drawer",
  "name": "Launch Drawer",
  "version": "0.1.0",
  "apiVersion": 1,
  "minAppVersion": "0.3.5",
  "description": "A multi-folder launcher drawer: pull apps, games, scripts and folders from several places at once, grouped by type instead of A-Z, with a most-used section and a collapsible handle.",
  "author": "you",
  "interactive": true,
  "permissions": {
    "storage": true,
    "desktop": true,
    "folders": true
  },
  "settings": [
    { "key": "title", "type": "text", "label": "Title", "default": "Launch" },
    { "key": "mode", "type": "select", "label": "Contents", "default": "all", "options": ["all", "curated"] },

    { "key": "folder1", "type": "filePath", "label": "Source 1 folder", "placeholder": "pick a folder", "pick": "folder" },
    { "key": "label1", "type": "text", "label": "Source 1 name", "placeholder": "Apps", "default": "" },
    { "key": "folder2", "type": "filePath", "label": "Source 2 folder", "placeholder": "pick a folder", "pick": "folder" },
    { "key": "label2", "type": "text", "label": "Source 2 name", "placeholder": "Games", "default": "" },
    { "key": "folder3", "type": "filePath", "label": "Source 3 folder", "placeholder": "pick a folder", "pick": "folder" },
    { "key": "label3", "type": "text", "label": "Source 3 name", "placeholder": "Scripts", "default": "" },
    { "key": "folder4", "type": "filePath", "label": "Source 4 folder", "placeholder": "pick a folder", "pick": "folder" },
    { "key": "label4", "type": "text", "label": "Source 4 name", "placeholder": "", "default": "" },
    { "key": "folder5", "type": "filePath", "label": "Source 5 folder", "placeholder": "pick a folder", "pick": "folder" },
    { "key": "label5", "type": "text", "label": "Source 5 name", "placeholder": "", "default": "" },

    { "key": "groupOrder", "type": "select", "label": "Group order",
      "options": ["apps first", "folders first", "most used first"], "default": "apps first" },
    { "key": "showFrequent", "type": "boolean", "label": "Most-used section", "default": true },
    { "key": "showHeaders", "type": "boolean", "label": "Section headers", "default": true },

    { "key": "showLabels", "type": "boolean", "label": "Show labels", "default": true },
    { "key": "iconSize", "type": "select", "label": "Icon size", "default": "medium", "options": ["small", "medium", "large"] },

    { "key": "collapsible", "type": "boolean", "label": "Collapsible", "default": true },
    { "key": "autoCollapse", "type": "boolean", "label": "Collapse after launch", "default": false,
      "showIf": { "key": "collapsible", "equals": true } },
    { "key": "collapseTo", "type": "select", "label": "Collapse toward", "default": "top", "options": ["top", "bottom", "left", "right"] },
    "panelStyle"
  ],
  "defaultSize": { "w": 6, "h": 6 },
  "minSize": { "w": 3, "h": 2 }
}
