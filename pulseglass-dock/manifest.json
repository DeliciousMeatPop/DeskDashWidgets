{
  "id": "pulseglass-dock",
  "name": "Pulseglass Dock",
  "version": "1.2.1",
  "apiVersion": 1,
  "minAppVersion": "0.3.5",
  "description": "Pulseglass Dock is a living glass taskbar for DeskDash that reacts to music and system activity. Inspired by Aurora, rebuilt as a full desktop dock — with magnification, number vitals, a movable clock, a network readout and a now-playing deck.",
  "author": "you",
  "kind": "bar",
  "bar": {
    "thickness": 128,
    "reserve": 56,
    "autoHide": { "hideDelay": 150, "revealBand": 2, "slide": 160 }
  },
  "popout": { "entry": "deck.html" },
  "settings": [
    "pins",
    "systray",

    { "key": "reactivity", "type": "select", "label": "Light field",
      "options": ["audio and vitals", "audio", "calm"], "default": "audio and vitals" },
    { "key": "runningStyle", "type": "select", "label": "Open apps shown by",
      "options": ["dots", "colour", "colour + dots"], "default": "colour + dots" },

    { "key": "startLabel", "type": "text", "label": "Start label", "placeholder": "Start", "default": "Pulseglass Dock" },
    { "key": "startPlacement", "type": "select", "label": "Start position", "options": ["left edge", "in the dock"], "default": "left edge" },

    { "key": "showRecycleBin", "type": "boolean", "label": "Recycle Bin", "default": false },
    { "key": "recyclePosition", "type": "select", "label": "Recycle Bin position",
      "options": ["in the dock", "left edge", "left of info", "far right"], "default": "in the dock",
      "showIf": { "key": "showRecycleBin", "equals": true } },

    { "key": "showTools", "type": "boolean", "label": "Tools button", "default": true },
    { "key": "toolsPosition", "type": "select", "label": "Tools button position",
      "options": ["in the dock", "left edge", "left of info", "far right"], "default": "left edge",
      "showIf": { "key": "showTools", "equals": true } },

    { "key": "magnify", "type": "select", "label": "Magnification",
      "options": ["everything", "apps only", "off"], "default": "everything" },
    { "key": "magnifyStrength", "type": "number", "label": "Magnify strength (%)", "min": 0, "max": 100, "default": 100 },
    { "key": "magnifyReach", "type": "number", "label": "Magnify reach (neighbours)", "min": 1, "max": 6, "default": 1 },

    { "key": "breathe", "type": "select", "label": "Breathing pulse",
      "options": ["everything", "icons only", "off"], "default": "everything" },
    { "key": "breathingInterval", "type": "number", "label": "Breathe every (seconds, 0 = off)", "min": 0, "max": 600, "default": 5 },

    { "key": "showClock", "type": "boolean", "label": "Clock", "default": true },
    { "key": "clockFace", "type": "select", "label": "Clock style",
      "options": ["standard", "large", "analog", "worded", "dual"], "default": "standard",
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockPosition", "type": "select", "label": "Clock position",
      "options": ["left edge (right)", "left edge (left)", "by info (left)", "far right"], "default": "far right",
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "format24h", "type": "boolean", "label": "24-hour clock", "default": false,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockSeconds", "type": "boolean", "label": "Show seconds", "default": false,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "secondaryTz", "type": "text", "label": "Second time zone (IANA)",
      "placeholder": "America/New_York", "default": "",
      "showIf": { "key": "clockFace", "equals": "dual" } },

    { "key": "showMedia", "type": "boolean", "label": "Now playing chip", "default": true },

    { "key": "showVitals", "type": "boolean", "label": "Vitals (CPU / RAM / GPU)", "default": true },
    { "key": "vitalsWarnAt", "type": "number", "label": "Warn above (%)", "min": 1, "max": 100, "default": 65,
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsDangerAt", "type": "number", "label": "Danger above (%)", "min": 1, "max": 100, "default": 90,
      "showIf": { "key": "showVitals", "equals": true } },

    { "key": "showNet", "type": "boolean", "label": "Network readout", "default": true },
    { "key": "netUnit", "type": "select", "label": "Network units",
      "options": ["MB/s", "Mbps", "Dynamic (KB/MB/GB)", "Dynamic (Kbps/Mbps/Gbps)"], "default": "Dynamic (KB/MB/GB)",
      "showIf": { "key": "showNet", "equals": true } },

    { "key": "weatherPlace", "type": "text", "label": "Weather location (city)", "placeholder": "London", "default": "" },
    { "key": "weatherUnits", "type": "select", "label": "Weather units", "options": ["fahrenheit", "celsius"], "default": "fahrenheit" },
    { "key": "showWeatherChip", "type": "boolean", "label": "Weather in the taskbar", "default": false }
  ],
  "permissions": {
    "taskbar": true,
    "time": true,
    "audio": true,
    "system": true,
    "systemControls": true,
    "media": true,
    "mediaControls": true,
    "systemApps": true,
    "storage": true,
    "http": { "hosts": ["geocoding-api.open-meteo.com", "api.open-meteo.com"], "rateLimit": 120 }
  }
}
