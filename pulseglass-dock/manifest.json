{
  "id": "pulseglass-dock",
  "name": "Pulseglass Dock",
  "version": "1.1.0",
  "apiVersion": 1,
  "minAppVersion": "0.3.5",
  "description": "Pulseglass Dock is a living glass taskbar for DeskDash that reacts to music and system activity. Inspired by Aurora, rebuilt as a full desktop dock — with magnification, number vitals, a movable clock, a network readout and a now-playing deck.",
  "author": "you",
  "kind": "bar",
  "bar": {
    "thickness": 128,
    "reserve": 56,
    "autoHide": { "hideDelay": 150, "revealBand": 2, "slide": 160 }
  },
  "popout": { "entry": "deck.html" },
  "settings": [
    "pins",
    "systray",

    { "key": "reactivity", "type": "select", "label": "Light field",
      "options": ["audio and vitals", "audio", "calm"], "default": "audio and vitals" },
    { "key": "customField", "type": "boolean", "label": "Custom light-field colours", "default": true },
    { "key": "fieldColorA", "type": "color", "label": "Light colour 1", "default": "#4ade80",
      "showIf": { "key": "customField", "equals": true } },
    { "key": "fieldColorB", "type": "color", "label": "Light colour 2", "default": "#38bdf8",
      "showIf": { "key": "customField", "equals": true } },
    { "key": "fieldColorC", "type": "color", "label": "Light colour 3", "default": "#a78bfa",
      "showIf": { "key": "customField", "equals": true } },
    { "key": "fieldGlow", "type": "number", "label": "Light-field glow (%)", "min": 0, "max": 250, "default": 100 },

    { "key": "runningStyle", "type": "select", "label": "Open apps shown by",
      "options": ["dots", "colour", "colour + dots"], "default": "colour + dots" },
    { "key": "dimIdle", "type": "number", "label": "Idle icon dim (%)", "min": 0, "max": 100, "default": 45,
      "showIf": { "key": "runningStyle", "equals": "colour" } },

    { "key": "startLabel", "type": "text", "label": "Start label", "placeholder": "Start", "default": "Pulseglass Dock" },
    { "key": "startImage", "type": "filePath", "label": "Start image (PNG/JPG)", "placeholder": "pick an image", "pick": "file" },
    { "key": "startSize", "type": "number", "label": "Start size (%)", "min": 60, "max": 180, "default": 100 },
    { "key": "startPlacement", "type": "select", "label": "Start position", "options": ["left edge", "in the dock"], "default": "left edge" },

    { "key": "showRecycleBin", "type": "boolean", "label": "Recycle Bin", "default": false },
    { "key": "recyclePosition", "type": "select", "label": "Recycle Bin position",
      "options": ["in the dock", "by start", "left of info", "far right"], "default": "in the dock",
      "showIf": { "key": "showRecycleBin", "equals": true } },
    { "key": "recycleOpen", "type": "select", "label": "Recycle Bin opens with",
      "options": ["default handler", "file explorer"], "default": "default handler",
      "showIf": { "key": "showRecycleBin", "equals": true } },
    { "key": "desktopSrc", "type": "filePath", "label": "Desktop source (blank = Desktop icons)", "placeholder": "leave blank", "pick": "folder",
      "showIf": { "key": "showRecycleBin", "equals": true } },

    { "key": "showTools", "type": "boolean", "label": "Tools & Power button", "default": true },
    { "key": "toolsPosition", "type": "select", "label": "Tools button position",
      "options": ["in the dock", "by start", "left of info", "far right"], "default": "by start",
      "showIf": { "key": "showTools", "equals": true } },
    { "key": "powerConfirm", "type": "boolean", "label": "Confirm shut down / restart / sign out", "default": true,
      "showIf": { "key": "showTools", "equals": true } },

    { "key": "magnify", "type": "boolean", "label": "Magnification (master)", "default": true },
    { "key": "magnifyApps", "type": "boolean", "label": "· magnify app icons", "default": true, "showIf": { "key": "magnify", "equals": true } },
    { "key": "magnifyStart", "type": "boolean", "label": "· magnify Start", "default": true, "showIf": { "key": "magnify", "equals": true } },
    { "key": "magnifyMedia", "type": "boolean", "label": "· magnify Now-playing", "default": true, "showIf": { "key": "magnify", "equals": true } },
    { "key": "magnifyRecycle", "type": "boolean", "label": "· magnify Recycle Bin", "default": true, "showIf": { "key": "magnify", "equals": true } },
    { "key": "magnifyTools", "type": "boolean", "label": "· magnify Tools", "default": true, "showIf": { "key": "magnify", "equals": true } },
    { "key": "magnifyStrength", "type": "number", "label": "Magnify strength (%)", "min": 0, "max": 100, "default": 100, "showIf": { "key": "magnify", "equals": true } },
    { "key": "magnifyReach", "type": "number", "label": "Magnify reach (neighbours)", "min": 1, "max": 6, "default": 1, "showIf": { "key": "magnify", "equals": true } },
    { "key": "breathing", "type": "boolean", "label": "Breathing pulse (master)", "default": true },
    { "key": "breatheApps", "type": "boolean", "label": "· breathe app icons", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheStart", "type": "boolean", "label": "· breathe Start", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheMedia", "type": "boolean", "label": "· breathe Now-playing", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheRecycle", "type": "boolean", "label": "· breathe Recycle Bin", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheTools", "type": "boolean", "label": "· breathe Tools", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheVitals", "type": "boolean", "label": "· breathe CPU/RAM/GPU", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheNet", "type": "boolean", "label": "· breathe Network", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheWeather", "type": "boolean", "label": "· breathe Weather", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheClock", "type": "boolean", "label": "· breathe Clock", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breatheTray", "type": "boolean", "label": "· breathe tray overflow", "default": true, "showIf": { "key": "breathing", "equals": true } },
    { "key": "breathingInterval", "type": "number", "label": "Breathe every (seconds, 0 = off)", "min": 0, "max": 600, "default": 5 },

    { "key": "spacing", "type": "number", "label": "Spacer margin (px)", "min": 0, "max": 40, "default": 8 },

    { "key": "showClock", "type": "boolean", "label": "Clock", "default": true },
    { "key": "clockFace", "type": "select", "label": "Clock style",
      "options": ["standard", "large", "analog", "worded", "dual"], "default": "standard",
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockPosition", "type": "select", "label": "Clock position",
      "options": ["by start (right)", "by start (left)", "by info (left)", "far right"], "default": "far right",
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "format24h", "type": "boolean", "label": "24-hour clock", "default": false,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockSeconds", "type": "boolean", "label": "Show seconds", "default": false,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockDate", "type": "boolean", "label": "Show date", "default": true,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "secondaryTz", "type": "text", "label": "Second time zone (IANA)",
      "placeholder": "America/New_York", "default": "",
      "showIf": { "key": "clockFace", "equals": "dual" } },

    { "key": "showMedia", "type": "boolean", "label": "Now playing chip", "default": true },
    { "key": "tabSystem", "type": "boolean", "label": "Now-playing: System tab", "default": true },
    { "key": "tabDrives", "type": "boolean", "label": "Now-playing: Drives tab", "default": true },
    { "key": "tabNetwork", "type": "boolean", "label": "Now-playing: Network tab", "default": true },
    { "key": "tabWeather", "type": "boolean", "label": "Now-playing: Weather tab", "default": true },

    { "key": "showVitals", "type": "boolean", "label": "Vitals (CPU / RAM / GPU)", "default": true },
    { "key": "vitalsWarnAt", "type": "number", "label": "Warn above (%)", "min": 1, "max": 100, "default": 65,
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsDangerAt", "type": "number", "label": "Danger above (%)", "min": 1, "max": 100, "default": 90,
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsNormalColor", "type": "color", "label": "Normal colour", "default": "#e7edf5",
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsWarnColor", "type": "color", "label": "Warn colour", "default": "#f59e0b",
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsDangerColor", "type": "color", "label": "Danger colour", "default": "#f87171",
      "showIf": { "key": "showVitals", "equals": true } },

    { "key": "showNet", "type": "boolean", "label": "Network readout", "default": true },
    { "key": "netLayout", "type": "select", "label": "Network layout", "options": ["stacked", "side by side"], "default": "side by side",
      "showIf": { "key": "showNet", "equals": true } },

    { "key": "weatherPlace", "type": "text", "label": "Weather location (city)", "placeholder": "London", "default": "" },
    { "key": "weatherUnits", "type": "select", "label": "Weather units", "options": ["fahrenheit", "celsius"], "default": "fahrenheit" },
    { "key": "weatherInterval", "type": "number", "label": "Weather update (seconds)", "min": 1, "max": 3600, "default": 900 },
    { "key": "showWeatherChip", "type": "boolean", "label": "Weather in the taskbar", "default": false },

    { "key": "edgePadding", "type": "number", "label": "Dock click margin (px)", "min": 0, "max": 80, "default": 25 },

    { "key": "badges", "type": "boolean", "label": "Notification badges  (unstable)", "default": false }
  ],
  "permissions": {
    "taskbar": true,
    "time": true,
    "audio": true,
    "system": true,
    "systemControls": true,
    "power": true,
    "media": true,
    "mediaControls": true,
    "systemApps": true,
    "desktop": true,
    "folders": true,
    "files": true,
    "storage": true,
    "links": { "prefixes": ["shell:"] },
    "http": { "hosts": ["geocoding-api.open-meteo.com", "api.open-meteo.com"], "rateLimit": 120 }
  }
}
