{
  "id": "aurora-dock",
  "name": "Aurora Dock",
  "version": "0.3.0",
  "apiVersion": 1,
  "minAppVersion": "0.3.5",
  "description": "A dock-style evolution of Aurora: segmented glass that cuts out empty space, true magnification, number or ring vitals, a movable clock, a network graph and a now-playing deck.",
  "author": "you",
  "kind": "bar",
  "bar": {
    "thickness": 128,
    "reserve": 56,
    "autoHide": { "hideDelay": 150, "revealBand": 2, "slide": 160 }
  },
  "popout": { "entry": "deck.html" },
  "settings": [
    "pins",
    "systray",

    { "key": "reactivity", "type": "select", "label": "Light field",
      "options": ["audio and vitals", "audio", "calm"], "default": "audio and vitals" },

    { "key": "startMode", "type": "select", "label": "Start button",
      "options": ["windows", "launcher"], "default": "windows" },
    { "key": "startLabel", "type": "text", "label": "Start button label", "placeholder": "Start", "default": "Start" },
    { "key": "launcherItems", "type": "text", "label": "Launcher shortcuts  (Name|https://url, comma separated)",
      "placeholder": "Search|https://google.com, Mail|https://mail.google.com",
      "default": "Search|https://www.google.com, Mail|https://mail.google.com, Calendar|https://calendar.google.com, DeskDash|https://www.desktop-dashboard.com",
      "showIf": { "key": "startMode", "equals": "launcher" } },

    { "key": "magnify", "type": "boolean", "label": "Dock magnification", "default": true },
    { "key": "magnifyStrength", "type": "number", "label": "Magnify strength (%)", "min": 0, "max": 100, "default": 60 },
    { "key": "magnifyReach", "type": "number", "label": "Magnify reach (neighbours)", "min": 1, "max": 6, "default": 2 },
    { "key": "breathing", "type": "boolean", "label": "Breathing pulse", "default": true },
    { "key": "breathingInterval", "type": "number", "label": "Breathe every (seconds, 0 = off)", "min": 0, "max": 600, "default": 5 },

    { "key": "showClock", "type": "boolean", "label": "Clock", "default": true },
    { "key": "clockFace", "type": "select", "label": "Clock style",
      "options": ["standard", "large", "analog", "worded", "dual"], "default": "standard",
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockPosition", "type": "select", "label": "Clock position",
      "options": ["by start (right)", "by start (left)", "by info (left)", "far right"], "default": "by start (right)",
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "format24h", "type": "boolean", "label": "24-hour clock", "default": false,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockSeconds", "type": "boolean", "label": "Show seconds", "default": false,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "clockDate", "type": "boolean", "label": "Show date", "default": true,
      "showIf": { "key": "showClock", "equals": true } },
    { "key": "secondaryTz", "type": "text", "label": "Second time zone (IANA)",
      "placeholder": "America/New_York", "default": "",
      "showIf": { "key": "clockFace", "equals": "dual" } },

    { "key": "showMedia", "type": "boolean", "label": "Now playing chip", "default": true },
    { "key": "showVitals", "type": "boolean", "label": "Vitals (CPU / RAM / GPU)", "default": true },
    { "key": "vitalsStyle", "type": "select", "label": "Vitals style", "options": ["numbers", "rings"], "default": "numbers",
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsWarnAt", "type": "number", "label": "Warn above (%)", "min": 1, "max": 100, "default": 50,
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsDangerAt", "type": "number", "label": "Danger above (%)", "min": 1, "max": 100, "default": 90,
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsNormalColor", "type": "color", "label": "Normal colour", "default": "#e7edf5",
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsWarnColor", "type": "color", "label": "Warn colour", "default": "#f59e0b",
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "vitalsDangerColor", "type": "color", "label": "Danger colour", "default": "#f87171",
      "showIf": { "key": "showVitals", "equals": true } },
    { "key": "showNet", "type": "boolean", "label": "Network readout", "default": true },

    { "key": "badges", "type": "boolean", "label": "Notification badges  (unstable)", "default": false }
  ],
  "permissions": {
    "taskbar": true,
    "time": true,
    "audio": true,
    "system": true,
    "systemControls": true,
    "media": true,
    "mediaControls": true,
    "links": { "prefixes": ["https://", "http://"] }
  }
}
